# --- Accounts -------------------------------------------------------------
# Signs sign-in sessions. Any long random string. Required in production.
SESSION_SECRET=
# Emails that become administrators when they sign up (comma-separated).
ADMIN_EMAILS=
# Optional: password of the original single-owner install. The owner account
# can sign in with it until they set their own password.
APP_PASSWORD=
# Public address of the site, used in email links.
APP_URL=https://binarytrades.vercel.app
# Shown as the support contact in the footer and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set to 1 to pause new sign-ups.
SIGNUPS_DISABLED=
# Account emails (confirmation and password reset) via Resend. EMAIL_FROM must
# be on a domain verified in Resend. Without these, new emails are trusted
# without confirmation and password reset by email is unavailable.
RESEND_API_KEY=
EMAIL_FROM=
# Encrypts broker API tokens at rest. Any long random string — keep it safe;
# changing it means reconnecting your brokers.
CREDENTIALS_ENCRYPTION_KEY=
# Lets an external scheduler run your bots 24/7: GET /api/cron/tick?key=...
CRON_SECRET=

# --- Storage --------------------------------------------------------------
# Leave the Supabase values empty to store everything in a local JSON file
# (DATA_FILE) — fine on your own PC or a VPS. Use Supabase on Vercel.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATA_FILE=.data/binarytrades.json

# --- Deriv ----------------------------------------------------------------
# Each Deriv connection stores its own App ID and Personal Access Token (entered
# on the Brokers page). DERIV_APP_ID is only used for public market data
# (candles); set it to your registered app's ID. 1089 is Deriv's public test ID.
DERIV_APP_ID=1089
# DERIV_API_URL=https://api.derivws.com
